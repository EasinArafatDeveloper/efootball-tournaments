datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  SUPER_ADMIN
  ADMIN
  MODERATOR
  TOURNAMENT_OFFICIAL
  SENIOR_REFEREE
  REFEREE
  CLUB_MANAGER
  PLAYER
}

enum Status {
  ACTIVE
  PENDING
  SUSPENDED
  BANNED
  INACTIVE
}

enum PlayerStatus {
  ACTIVE
  PENDING_VERIFICATION
  SUSPENDED
  BANNED
  INACTIVE
}

enum ContractStatus {
  FREE_AGENT
  UNDER_CONTRACT
  UNDER_TERMINATION
  TRANSFER_LISTED
}

enum RefereeTier {
  TIER_1
  TIER_2
  TIER_3
}

enum TournamentFormat {
  SINGLE_ELIMINATION
  DOUBLE_ELIMINATION
  LEAGUE_ROUND_ROBIN
  GROUP_AND_KNOCKOUT
  SWISS
  CLUB_BATTLE
  NATIONAL_TOURNAMENT
}

enum TournamentStatus {
  DRAFT
  REGISTRATION_OPEN
  REGISTRATION_CLOSED
  ONGOING
  COMPLETED
  CANCELLED
}

enum FixtureStatus {
  SCHEDULED
  LIVE
  FINISHED
  POSTPONED
  CANCELLED
}

enum VerificationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum TransferStatus {
  AVAILABLE
  LISTED
  NEGOTIATING
  TRANSFERRED
  UNAVAILABLE
}

enum RequestStatus {
  PENDING
  ACCEPTED
  REJECTED
  CANCELLED
}

enum DisputeStatus {
  OPEN
  UNDER_REVIEW
  RESOLVED
  REJECTED
}

enum TimelineEventType {
  KICKOFF
  GOAL
  ASSIST
  YELLOW_CARD
  RED_CARD
  PENALTY
  OWN_GOAL
  MOTM
  FINAL_WHISTLE
}

model User {
  id                    String              @id @default(cuid())
  email                 String              @unique
  username              String              @unique
  passwordHash          String
  fullName              String
  avatar                String?
  role                  Role                @default(PLAYER)
  status                Status              @default(ACTIVE)
  emailVerified         Boolean             @default(false)
  phone                 String?
  location              String?
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  playerProfile         PlayerProfile?
  refereeProfile        Referee?
  managedClubs          Club[]              @relation("ClubManager")
  notifications         Notification[]
  auditLogs             AuditLog[]
  sessions              Session[]
  disputes              MatchDispute[]
}

model Session {
  id                    String              @id @default(cuid())
  userId                String
  token                 String              @unique
  expiresAt             DateTime
  createdAt             DateTime            @default(now())

  user                  User                @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model PasswordResetToken {
  id                    String              @id @default(cuid())
  email                 String
  token                 String              @unique
  expiresAt             DateTime
  createdAt             DateTime            @default(now())
}

model EmailVerificationToken {
  id                    String              @id @default(cuid())
  email                 String
  token                 String              @unique
  expiresAt             DateTime
  createdAt             DateTime            @default(now())
}

model PlayerProfile {
  id                    String              @id @default(cuid())
  userId                String              @unique
  konamiId              String              @unique
  deviceModel           String
  facebookProfile       String?
  preferredPosition     String              @default("CF")
  playStyle             String              @default("Possession Game")
  bio                   String?
  rating                Int                 @default(750)
  marketValue           Float               @default(50.0) // In Millions USD
  status                PlayerStatus        @default(ACTIVE)
  formHistory           String              @default("W,W,D,W,L") // W,D,L format
  motmCount             Int                 @default(0)
  joinDate              DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  user                  User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  stats                 PlayerStats?
  contract              PlayerContract?
  clubMemberships       ClubMember[]
  homeFixtures          Fixture[]           @relation("HomePlayer")
  awayFixtures          Fixture[]           @relation("AwayPlayer")
  motmMatches           MatchResult[]       @relation("MotmPlayer")
  transferListings      TransferListing[]
  transferRequestsSent  TransferRequest[]   @relation("PlayerTransfers")
  transferHistories     TransferHistory[]
  achievements          PlayerAchievement[]
  trophies              Trophy[]            @relation("PlayerTrophies")
  suspensions           Suspension[]        @relation("PlayerSuspensions")
  tournamentsJoined     TournamentParticipant[]
}

model PlayerStats {
  id                    String              @id @default(cuid())
  playerId              String              @unique
  matchesPlayed         Int                 @default(0)
  wins                  Int                 @default(0)
  losses                Int                 @default(0)
  draws                 Int                 @default(0)
  winRate               Float               @default(0.0)
  goalsScored           Int                 @default(0)
  assists               Int                 @default(0)
  cleanSheets           Int                 @default(0)
  goalsConceded         Int                 @default(0)
  points                Int                 @default(0)

  player                PlayerProfile       @relation(fields: [playerId], references: [id], onDelete: Cascade)
}

model PlayerContract {
  id                    String              @id @default(cuid())
  playerId              String              @unique
  clubId                String?
  status                ContractStatus      @default(FREE_AGENT)
  startDate             DateTime?
  endDate               DateTime?
  durationMonths        Int                 @default(12)
  releaseClause         Float?
  notes                 String?

  player                PlayerProfile       @relation(fields: [playerId], references: [id], onDelete: Cascade)
  club                  Club?               @relation(fields: [clubId], references: [id], onDelete: SetNull)
}

model Club {
  id                    String              @id @default(cuid())
  name                  String              @unique
  shortName             String
  slug                  String              @unique
  logo                  String?
  banner                String?
  managerId             String?
  location              String              @default("Dhaka, Bangladesh")
  facebookPage          String?
  description           String?
  foundedDate           DateTime            @default(now())
  status                Status              @default(ACTIVE)
  marketValue           Float               @default(250.0)
  points                Int                 @default(0)
  formHistory           String              @default("W,W,W,D,L")
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  manager               User?               @relation("ClubManager", fields: [managerId], references: [id], onDelete: SetNull)
  members               ClubMember[]
  contracts             PlayerContract[]
  homeFixtures          Fixture[]           @relation("HomeClub")
  awayFixtures          Fixture[]           @relation("AwayClub")
  tournamentEntries     TournamentParticipant[]
  trophies              Trophy[]            @relation("ClubTrophies")
  suspensions           Suspension[]        @relation("ClubSuspensions")
  transfersIncoming     TransferRequest[]   @relation("TargetClub")
  transfersOutgoing     TransferRequest[]   @relation("CurrentClub")
  transferHistoriesPrev TransferHistory[]   @relation("PrevClub")
  transferHistoriesNew  TransferHistory[]   @relation("NewClub")
}

model ClubMember {
  id                    String              @id @default(cuid())
  clubId                String
  playerId              String
  jerseyNumber          Int?
  role                  String              @default("Player") // Captain, Vice Captain, Starter, Sub
  isActive              Boolean             @default(true)
  joinedAt              DateTime            @default(now())

  club                  Club                @relation(fields: [clubId], references: [id], onDelete: Cascade)
  player                PlayerProfile       @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@unique([clubId, playerId])
}

model Referee {
  id                    String              @id @default(cuid())
  userId                String              @unique
  officialId            String              @unique
  tier                  RefereeTier         @default(TIER_2)
  rating                Float               @default(4.8)
  matchesOfficiated     Int                 @default(0)
  completedMatches      Int                 @default(0)
  disputesHandled       Int                 @default(0)
  status                Status              @default(ACTIVE)
  joinedDate            DateTime            @default(now())

  user                  User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  assignments           RefereeAssignment[]
  ratings               RefereeRating[]
}

model RefereeAssignment {
  id                    String              @id @default(cuid())
  fixtureId             String              @unique
  refereeId             String
  assignedRole          String              @default("Head Referee")
  reportNotes           String?
  evidenceUrls          String[]
  status                VerificationStatus  @default(PENDING)
  createdAt             DateTime            @default(now())

  fixture               Fixture             @relation(fields: [fixtureId], references: [id], onDelete: Cascade)
  referee               Referee             @relation(fields: [refereeId], references: [id], onDelete: Cascade)
}

model RefereeRating {
  id                    String              @id @default(cuid())
  refereeId             String
  score                 Float
  feedback              String?
  createdAt             DateTime            @default(now())

  referee               Referee             @relation(fields: [refereeId], references: [id], onDelete: Cascade)
}

model Tournament {
  id                    String              @id @default(cuid())
  name                  String
  slug                  String              @unique
  banner                String?
  logo                  String?
  description           String?
  format                TournamentFormat    @default(SINGLE_ELIMINATION)
  gameCategory          String              @default("eFootball Mobile")
  platform              String              @default("Mobile")
  seasonId              String?
  startDate             DateTime
  endDate               DateTime
  registrationDeadline  DateTime
  maxParticipants       Int                 @default(32)
  entryFee              Float               @default(0.0)
  prizePool             String              @default("50,000 BDT")
  rules                 String?
  status                TournamentStatus    @default(REGISTRATION_OPEN)
  progressPercent       Int                 @default(0)
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  season                Season?             @relation(fields: [seasonId], references: [id], onDelete: SetNull)
  participants          TournamentParticipant[]
  fixtures              Fixture[]
  trophies              Trophy[]
}

model TournamentParticipant {
  id                    String              @id @default(cuid())
  tournamentId          String
  playerId              String?
  clubId                String?
  seedNumber            Int?
  status                VerificationStatus  @default(APPROVED)
  registeredAt          DateTime            @default(now())

  tournament            Tournament          @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  player                PlayerProfile?      @relation(fields: [playerId], references: [id], onDelete: Cascade)
  club                  Club?               @relation(fields: [clubId], references: [id], onDelete: Cascade)
}

model Fixture {
  id                    String              @id @default(cuid())
  tournamentId          String?
  homeClubId            String?
  awayClubId            String?
  homePlayerId          String?
  awayPlayerId          String?
  scheduledDate         DateTime
  venue                 String              @default("Online / Konami Server 01")
  round                 String              @default("Round of 16")
  bracketPosition       String?             // e.g., "R1-M1", "QF-1", "SF-1", "FINAL"
  status                FixtureStatus       @default(SCHEDULED)
  isOnStream            Boolean             @default(false)
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  tournament            Tournament?         @relation(fields: [tournamentId], references: [id], onDelete: SetNull)
  homeClub              Club?               @relation("HomeClub", fields: [homeClubId], references: [id], onDelete: SetNull)
  awayClub              Club?               @relation("AwayClub", fields: [awayClubId], references: [id], onDelete: SetNull)
  homePlayer            PlayerProfile?      @relation("HomePlayer", fields: [homePlayerId], references: [id], onDelete: SetNull)
  awayPlayer            PlayerProfile?      @relation("AwayPlayer", fields: [awayPlayerId], references: [id], onDelete: SetNull)
  result                MatchResult?
  timelineEvents        MatchTimelineEvent[]
  stream                Stream?
  refereeAssignment     RefereeAssignment?
  disputes              MatchDispute[]
}

model MatchResult {
  id                    String              @id @default(cuid())
  fixtureId             String              @unique
  homeScore             Int                 @default(0)
  awayScore             Int                 @default(0)
  homePenalties         Int?
  awayPenalties         Int?
  motmPlayerId          String?
  motmReason            String?
  proofScreenshot       String?
  refereeNotes          String?
  status                VerificationStatus  @default(PENDING)
  submittedBy           String?
  verifiedAt            DateTime?
  createdAt             DateTime            @default(now())

  fixture               Fixture             @relation(fields: [fixtureId], references: [id], onDelete: Cascade)
  motmPlayer            PlayerProfile?      @relation("MotmPlayer", fields: [motmPlayerId], references: [id], onDelete: SetNull)
}

model MatchTimelineEvent {
  id                    String              @id @default(cuid())
  fixtureId             String
  minute                Int
  type                  TimelineEventType
  title                 String
  description           String?
  scorerPlayerName      String?
  assisterPlayerName    String?
  isHomeTeam            Boolean             @default(true)
  createdAt             DateTime            @default(now())

  fixture               Fixture             @relation(fields: [fixtureId], references: [id], onDelete: Cascade)
}

model Stream {
  id                    String              @id @default(cuid())
  fixtureId             String              @unique
  platform              String              @default("YouTube") // YouTube, Twitch, Facebook
  channelName           String
  streamUrl             String
  viewerCount           Int                 @default(0)
  isLive                Boolean             @default(true)

  fixture               Fixture             @relation(fields: [fixtureId], references: [id], onDelete: Cascade)
}

model MatchDispute {
  id                    String              @id @default(cuid())
  fixtureId             String
  raisedById            String
  category              String              // Result Discrepancy, Cheating, Network Lag
  description           String
  evidenceUrls          String[]
  status                DisputeStatus       @default(OPEN)
  adminNotes            String?
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  fixture               Fixture             @relation(fields: [fixtureId], references: [id], onDelete: Cascade)
  raisedBy              User                @relation(fields: [raisedById], references: [id], onDelete: Cascade)
}

model TransferWindow {
  id                    String              @id @default(cuid())
  name                  String              @default("Summer 2026 Window")
  isOpen                Boolean             @default(true)
  startDate             DateTime
  endDate               DateTime
  description           String?
}

model TransferListing {
  id                    String              @id @default(cuid())
  playerId              String
  askingPrice           Float               @default(50.0) // In Millions USD
  status                TransferStatus      @default(LISTED)
  listedDate            DateTime            @default(now())
  notes                 String?

  player                PlayerProfile       @relation(fields: [playerId], references: [id], onDelete: Cascade)
}

model TransferRequest {
  id                    String              @id @default(cuid())
  playerId              String
  currentClubId         String?
  targetClubId          String
  offeredFee            Float               @default(50.0)
  proposedSalary        Float?
  status                RequestStatus       @default(PENDING)
  message               String?
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  player                PlayerProfile       @relation("PlayerTransfers", fields: [playerId], references: [id], onDelete: Cascade)
  currentClub           Club?               @relation("CurrentClub", fields: [currentClubId], references: [id], onDelete: SetNull)
  targetClub            Club                @relation("TargetClub", fields: [targetClubId], references: [id], onDelete: Cascade)
}

model TransferHistory {
  id                    String              @id @default(cuid())
  playerId              String
  previousClubId        String?
  newClubId             String
  fee                   Float               @default(0.0)
  transferDate          DateTime            @default(now())
  contractDuration      Int                 @default(12)
  approvedBy            String?

  player                PlayerProfile       @relation(fields: [playerId], references: [id], onDelete: Cascade)
  previousClub          Club?               @relation("PrevClub", fields: [previousClubId], references: [id], onDelete: SetNull)
  newClub               Club                @relation("NewClub", fields: [newClubId], references: [id], onDelete: Cascade)
}

model DisciplinaryAction {
  id                    String              @id @default(cuid())
  targetType            String              // PLAYER or CLUB
  targetId              String
  reason                String
  penalty               String
  issuedBy              String
  createdAt             DateTime            @default(now())
}

model Suspension {
  id                    String              @id @default(cuid())
  playerId              String?
  clubId                String?
  reason                String
  startDate             DateTime            @default(now())
  endDate               DateTime
  evidence              String?
  issuedBy              String
  status                Status              @default(SUSPENDED)
  notes                 String?
  createdAt             DateTime            @default(now())

  player                PlayerProfile?      @relation("PlayerSuspensions", fields: [playerId], references: [id], onDelete: Cascade)
  club                  Club?               @relation("ClubSuspensions", fields: [clubId], references: [id], onDelete: Cascade)
}

model Achievement {
  id                    String              @id @default(cuid())
  name                  String              @unique
  badgeIcon             String
  description           String
  category              String              @default("Combat")
  unlockedCount         Int                 @default(0)

  playerAchievements    PlayerAchievement[]
}

model PlayerAchievement {
  id                    String              @id @default(cuid())
  playerId              String
  achievementId         String
  unlockedAt            DateTime            @default(now())

  player                PlayerProfile       @relation(fields: [playerId], references: [id], onDelete: Cascade)
  achievement           Achievement         @relation(fields: [achievementId], references: [id], onDelete: Cascade)

  @@unique([playerId, achievementId])
}

model Trophy {
  id                    String              @id @default(cuid())
  title                 String
  season                String
  year                  Int                 @default(2026)
  position              String              @default("CHAMPION")
  awardIcon             String              @default("Trophy")
  tournamentId          String?
  playerId              String?
  clubId                String?
  createdAt             DateTime            @default(now())

  tournament            Tournament?         @relation(fields: [tournamentId], references: [id], onDelete: SetNull)
  player                PlayerProfile?      @relation("PlayerTrophies", fields: [playerId], references: [id], onDelete: Cascade)
  club                  Club?               @relation("ClubTrophies", fields: [clubId], references: [id], onDelete: Cascade)
}

model Season {
  id                    String              @id @default(cuid())
  name                  String              @unique // "Season 2026", "Season 2027"
  year                  Int                 @default(2026)
  isActive              Boolean             @default(true)
  startDate             DateTime
  endDate               DateTime

  tournaments           Tournament[]
  awards                SeasonAward[]
}

model SeasonAward {
  id                    String              @id @default(cuid())
  seasonId              String
  title                 String              // Player of the Season, Top Scorer, MOTM Leader
  winnerName            String
  winnerAvatar          String?
  clubName              String?
  statisticSummary      String?

  season                Season              @relation(fields: [seasonId], references: [id], onDelete: Cascade)
}

model NewsCategory {
  id                    String              @id @default(cuid())
  name                  String              @unique
  slug                  String              @unique

  articles              NewsArticle[]
}

model NewsArticle {
  id                    String              @id @default(cuid())
  title                 String
  slug                  String              @unique
  excerpt               String
  content               String
  featuredImage         String?
  author                String              @default("NECOB Editorial")
  categoryId            String?
  tags                  String[]
  publishedDate         DateTime            @default(now())
  views                 Int                 @default(0)
  isFeatured            Boolean             @default(false)

  category              NewsCategory?       @relation(fields: [categoryId], references: [id], onDelete: SetNull)
}

model Event {
  id                    String              @id @default(cuid())
  name                  String
  slug                  String              @unique
  banner                String?
  description           String
  venue                 String
  eventDate             DateTime
  capacity              Int                 @default(500)
  registeredCount       Int                 @default(0)
  status                Status              @default(ACTIVE)
}

model Partner {
  id                    String              @id @default(cuid())
  name                  String
  logo                  String?
  category              String              @default("University") // University, Esports Club, Community, Media
  website               String?
  facebook              String?
  description           String?
  sortOrder             Int                 @default(0)
  status                Status              @default(ACTIVE)
}

model Sponsor {
  id                    String              @id @default(cuid())
  name                  String
  logo                  String?
  website               String?
  description           String?
  placement             String              @default("Homepage") // Homepage, Tournament, Footer, MatchCentre
  priority              Int                 @default(1)
  status                Status              @default(ACTIVE)
}

model LeadershipMember {
  id                    String              @id @default(cuid())
  name                  String
  role                  String              // Founder, President, Head of Referees, Tournament Director
  category              String              @default("Core Team") // Leadership, Founders, Core Team, Elite Members
  photo                 String?
  period                String              @default("2024 - Present")
  bio                   String?
  facebook              String?
  sortOrder             Int                 @default(0)
}

model ActivityEvent {
  id                    String              @id @default(cuid())
  type                  String              // MATCH_WIN, MOTM_AWARD, GOALS_SCORED, TRANSFER, TOURNAMENT_START, DISCIPLINARY
  category              String              @default("Matches") // Matches, Players, Clubs, Transfers, Tournaments, Awards, Disciplinary
  title                 String
  description           String
  targetUrl             String?
  avatar                String?
  createdAt             DateTime            @default(now())
}

model Notification {
  id                    String              @id @default(cuid())
  userId                String
  title                 String
  message               String
  type                  String              @default("INFO") // INFO, SUCCESS, WARNING, FIXTURE, TRANSFER, DISPUTE
  link                  String?
  isRead                Boolean             @default(false)
  createdAt             DateTime            @default(now())

  user                  User                @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AuditLog {
  id                    String              @id @default(cuid())
  adminId               String
  action                String              // e.g. "APPROVED_MATCH_RESULT", "SUSPENDED_PLAYER"
  target                String
  details               String?
  ipAddress             String?             @default("127.0.0.1")
  createdAt             DateTime            @default(now())

  admin                 User                @relation(fields: [adminId], references: [id], onDelete: Cascade)
}

model SystemSetting {
  id                    String              @id @default(cuid())
  key                   String              @unique
  value                 String
  description           String?
  updatedAt             DateTime            @updatedAt
}
